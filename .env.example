# Cleat environment template.
# Copy to .env for local overrides. Never commit real values.
# Ticket 0 runs with these left blank. Later tickets read them.

# --- Supabase (server) ---
# Project URL and keys from the Supabase dashboard. Not required to clone or boot.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role bypasses RLS. Server only. Never prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_.
# Put it in apps/web/.env.local for AI writes. Do not put it in apps/mobile/.env.
SUPABASE_SERVICE_ROLE=
# Direct Postgres URL for `pnpm seed` only. Not read by the web or mobile apps.
# Leave unset to use the local Supabase database on port 54322.
DATABASE_URL=

# --- Supabase (Expo client) ---
# Inlined into the mobile bundle. Anon key only.
# Expo reads these from apps/mobile/.env when you run `npx expo start`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Trainer desk origin the client calls when sending a chat message.
# The server hook for Ticket 4 runs there. Defaults to http://localhost:3000.
EXPO_PUBLIC_DESK_URL=http://localhost:3000

# --- Supabase (Next.js client) ---
# Inlined into the trainer web bundle. Anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Origin of the Expo client, used when a trainer copies an invite link.
# Expo web defaults to this. Override it if Metro is on another host or port.
NEXT_PUBLIC_CLIENT_APP_URL=http://localhost:8081

# --- OpenAI (server only, Ticket 4) ---
# Leave this unset to use the deterministic hash embedder and canned scorer.
# Set it on the Next.js server to call text-embedding-3-small and gpt-4o-mini.
# Never prefix it with NEXT_PUBLIC_ or EXPO_PUBLIC_. The Expo app must not read it.
OPENAI_API_KEY=

# --- Priority inbox (server only) ---
# Hours before an unanswered client message becomes a P2 inbox item.
# Clamped to 1 through 168. Default 4 when unset or not a number.
# Used when the org has not saved a window. A saved org setting overrides this.
INBOX_UNANSWERED_HOURS=

# --- ICS subscribe URLs (server only, Ticket 6) ---
# Signs tokenized calendar feed URLs. ICS works without Google.
# Use at least 16 characters. Never prefix this with NEXT_PUBLIC_ or EXPO_PUBLIC_.
ICS_FEED_SIGNING_SECRET=

# Web origin the Expo app calls for book, cancel, and ICS download.
# Server only secrets above stay out of this value.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# --- Google Calendar OAuth (optional, Ticket 6) ---
# Leave both blank. The desk then hides Google connect and uses ICS only.
# Server only. Never prefix these with NEXT_PUBLIC_ or EXPO_PUBLIC_.
# The only scope is https://www.googleapis.com/auth/calendar.events.
# Redirect URI: http://localhost:3000/api/google/oauth/callback
# SUPABASE_SERVICE_ROLE (server only) is required before connect can store a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
