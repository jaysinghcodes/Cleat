{
  "name": "cleat",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "stop": "bash scripts/stop.sh",
    "dev:web": "pnpm --filter @cleat/web dev",
    "dev:mobile": "pnpm --filter @cleat/mobile start",
    "seed": "pnpm --filter @cleat/db seed",
    "eval": "pnpm --filter @cleat/ai exec tsx ../../scripts/run-eval.ts",
    "build": "pnpm --filter @cleat/web build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "pnpm -r --if-present test && node --test scripts/onboarding.test.mjs"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
