{
  "name": "coachloop",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @coachloop/web dev",
    "dev:mobile": "pnpm --filter @coachloop/mobile start",
    "build": "pnpm --filter @coachloop/web build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
